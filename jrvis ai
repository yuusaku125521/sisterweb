"""
音声入力モジュール(音声認識)

Enterキーを押すと録音開始、もう一度Enterキーを押すと録音終了し、
faster-whisperでテキストに変換する(プッシュトゥトーク方式)。

初回実行時はWhisperモデルのダウンロードが発生する(数百MB程度、ネット接続が必要)。
一度ダウンロードすればその後はローカルで動作する。
"""

import queue
import tempfile

import numpy as np
import sounddevice as sd
import soundfile as sf
from faster_whisper import WhisperModel

# --- 設定 ---------------------------------------------------------------

SAMPLE_RATE = 16000  # Whisperが想定するサンプリングレート
# モデルサイズ: tiny / base / small / medium / large から選択
# 小さいほど高速・低精度、大きいほど高精度・低速。日本語ならsmall以上推奨。
MODEL_SIZE = "small"

# WhisperModelの初期化は重いので、モジュール読み込み時に一度だけ行う
_model = WhisperModel(MODEL_SIZE, device="cpu", compute_type="int8")


# --- 録音 ---------------------------------------------------------------

def record_until_enter() -> np.ndarray:
    """Enterキーが押されるまでマイクから録音を続ける"""
    q = queue.Queue()

    def callback(indata, frames, time, status):
        q.put(indata.copy())

    print("録音中... (話し終えたらEnterキーを押してください)")
    frames = []
    with sd.InputStream(
        samplerate=SAMPLE_RATE, channels=1, dtype="float32", callback=callback
    ):
        input()  # ここでEnter待ち

    while not q.empty():
        frames.append(q.get())

    if not frames:
        return np.zeros((0,), dtype=np.float32)
    return np.concatenate(frames, axis=0).flatten()


# --- 文字起こし ------------------------------------------------------------

# この値未満の音量(RMS)しか無い場合は「無音」とみなし、文字起こしをスキップする
# (Whisperは無音に対して「ご視聴ありがとうございました」等を誤生成する癖があるため)
SILENCE_THRESHOLD = 0.005


def transcribe(audio: np.ndarray) -> str:
    """録音した音声データをテキストに変換する"""
    if audio.size == 0:
        return ""

    # 音量(RMS)をチェックし、ほぼ無音なら誤生成を避けるため文字起こしをスキップ
    rms = float(np.sqrt(np.mean(np.square(audio))))
    if rms < SILENCE_THRESHOLD:
        return ""

    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        sf.write(f.name, audio, SAMPLE_RATE)
        segments, _ = _model.transcribe(f.name, language="ja")
        text = "".join(segment.text for segment in segments)

    return text.strip()


# main.py側の終了判定と合わせる特別な合図(録音前にこの文字を入力すると終了できる)
QUIT_SIGNAL = "__QUIT__"


def listen() -> str:
    """録音→文字起こしまでをまとめて行う入口関数"""
    pre_input = input(
        "Enterキーを押すと録音を開始します(qと入力してEnterで終了)..."
    ).strip().lower()
    if pre_input in ("q", "exit", "quit", "終了"):
        return QUIT_SIGNAL

    audio = record_until_enter()
    print("文字起こし中...")
    return transcribe(audio)

"""
JARVISが使える「ツール」を定義するモジュール。

Claude APIのTool Use機能と連携し、ユーザーの発言に応じて
実際の処理(今回はタイマー機能)を実行する。
"""

import threading
import time

import voicevox

# --- Claude APIに渡すツール定義 --------------------------------------------
# ここで定義した内容をもとに、Claudeが「このツールを呼びたい」と判断する。

TOOLS = [
    {
        "name": "set_timer",
        "description": (
            "指定した秒数後に通知するタイマーをセットする。"
            "「3分タイマー」「5分後に教えて」等のリクエストに使う。"
        ),
        "input_schema": {
            "type": "object",
            "properties": {
                "seconds": {
                    "type": "integer",
                    "description": "タイマーの秒数(例: 3分なら180)",
                },
                "label": {
                    "type": "string",
                    "description": "何のタイマーか(例: 'カップ麺', '休憩'など)。指定がなければ空文字でよい。",
                },
            },
            "required": ["seconds"],
        },
    }
]


# --- タイマーの実行本体 -----------------------------------------------------

def _timer_thread(seconds: int, label: str):
    time.sleep(seconds)
    if label:
        message = f"マスター、{label}のタイマーが終了いたしました。"
    else:
        message = "マスター、タイマーが終了いたしました。"
    print(f"\n[タイマー通知] {message}")
    voicevox.speak(message)


def set_timer(seconds: int, label: str = "") -> str:
    """タイマーをバックグラウンドで開始し、Claudeに返す結果テキストを返す"""
    thread = threading.Thread(target=_timer_thread, args=(seconds, label), daemon=True)
    thread.start()
    return f"{seconds}秒のタイマーを開始しました。"


# --- ツール名 → 実行関数 の対応表 -------------------------------------------

TOOL_FUNCTIONS = {
    "set_timer": lambda tool_input: set_timer(
        seconds=tool_input["seconds"], label=tool_input.get("label", "")
    ),
}


def execute_tool(name: str, tool_input: dict) -> str:
    """ツール名と引数を受け取り、対応する関数を実行して結果を返す"""
    func = TOOL_FUNCTIONS.get(name)
    if func is None:
        return f"エラー: 未知のツール '{name}' が呼び出されました。"
    return func(tool_input)

"""
VOICEVOX連携モジュール

前提: VOICEVOXアプリ(公式サイトからダウンロード)を起動しておくこと。
起動すると、ローカルに音声合成用のAPIサーバー(デフォルト: http://127.0.0.1:50021)が立ち上がる。
このモジュールはそのAPIにテキストを送り、音声を生成して再生する。
"""

import io
import platform
import subprocess
import tempfile

import requests

VOICEVOX_URL = "http://127.0.0.1:50021"

# スピーカーID(声の種類)。VOICEVOXアプリで確認・変更可能。
# 代表例: 2 = 四国めたん(ノーマル), 3 = ずんだもん(ノーマル), 11 = 玄野武宏(ノーマル)など
# JARVIS風の落ち着いた声にしたい場合は、アプリ内で低めのトーンの男性ボイスを探して番号を変更する。
SPEAKER_ID = 11


def is_voicevox_running() -> bool:
    """VOICEVOXアプリ(APIサーバー)が起動しているか確認する"""
    try:
        res = requests.get(f"{VOICEVOX_URL}/version", timeout=2)
        return res.status_code == 200
    except requests.exceptions.RequestException:
        return False


def synthesize(text: str, speaker: int = SPEAKER_ID) -> bytes:
    """テキストをVOICEVOXで音声(wavバイナリ)に変換する"""
    # 1. 発音・イントネーション情報(audio_query)を取得
    query_res = requests.post(
        f"{VOICEVOX_URL}/audio_query",
        params={"text": text, "speaker": speaker},
        timeout=10,
    )
    query_res.raise_for_status()
    audio_query = query_res.json()

    # 2. audio_queryをもとに音声を合成
    synth_res = requests.post(
        f"{VOICEVOX_URL}/synthesis",
        params={"speaker": speaker},
        json=audio_query,
        timeout=30,
    )
    synth_res.raise_for_status()
    return synth_res.content


def play_wav_bytes(wav_bytes: bytes):
    """wavバイナリを一時ファイルに保存し、OS標準の方法で再生する"""
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        f.write(wav_bytes)
        path = f.name

    system = platform.system()
    if system == "Darwin":  # macOS
        subprocess.run(["afplay", path], check=False)
    elif system == "Windows":
        import winsound

        winsound.PlaySound(path, winsound.SND_FILENAME)
    else:  # Linux
        subprocess.run(["aplay", path], check=False)


def speak(text: str, speaker: int = SPEAKER_ID):
    """テキストを音声合成して再生する(呼び出し用の入口関数)"""
    if not is_voicevox_running():
        print("[警告] VOICEVOXが起動していないため、音声再生をスキップしました。")
        return
    try:
        wav_bytes = synthesize(text, speaker)
        play_wav_bytes(wav_bytes)
    except requests.exceptions.RequestException as e:
        print(f"[警告] VOICEVOXとの通信に失敗しました: {e}")
