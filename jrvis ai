"""
JARVIS風AIアシスタント - 会話エンジン(最小構成)

まずはテキストベースでClaude APIと会話できる土台を作る。
後の工程で VOICEVOX(音声出力)や音声認識(音声入力)を追加していく。
"""

import os
import sys
from anthropic import Anthropic

import voicevox
import speech_input
import tools

# --- 設定 ---------------------------------------------------------------

MODEL = "claude-sonnet-4-6"  # 使用するClaudeモデル
MAX_TOKENS = 1024

# JARVISらしい人格・口調をシステムプロンプトで定義する
SYSTEM_PROMPT = """\
あなたは映画「アイアンマン」に登場するAIアシスタント「JARVIS」のような執事型AIです。
以下の特徴を守って応答してください。

- 常に丁寧で落ち着いた口調(「〜でございます」「かしこまりました」等)
- 知的で簡潔、余計な前置きをしない
- ユーザーを「マスター」または「ご主人様」と呼ぶ(ユーザーが別の呼び方を指定したらそれに従う)
- 必要に応じて気の利いた一言や、状況への軽い気配りを添える
- 日本語で応答する
"""


# --- 会話履歴の管理 -------------------------------------------------------

class ConversationHistory:
    """Claude APIに渡す会話履歴を保持するクラス"""

    def __init__(self):
        self.messages = []

    def add_user_message(self, text: str):
        self.messages.append({"role": "user", "content": text})

    def add_assistant_content(self, content):
        """Claudeからの応答(テキスト+tool_useブロックを含む場合あり)をそのまま保存"""
        self.messages.append({"role": "assistant", "content": content})

    def add_tool_result(self, tool_use_id: str, result_text: str):
        """ツール実行結果をuserロールのtool_resultとして追加する"""
        self.messages.append(
            {
                "role": "user",
                "content": [
                    {
                        "type": "tool_result",
                        "tool_use_id": tool_use_id,
                        "content": result_text,
                    }
                ],
            }
        )

    def as_list(self):
        return self.messages


# --- Claude API呼び出し(Tool Use対応) --------------------------------------

def call_claude(client: Anthropic, history: ConversationHistory) -> str:
    """
    会話履歴を渡してClaudeの応答テキストを取得する。
    Claudeがツール(タイマー等)を呼び出したい場合は、実際に実行して結果を返し、
    最終的なテキスト応答が得られるまでやり取りを繰り返す。
    """
    while True:
        response = client.messages.create(
            model=MODEL,
            max_tokens=MAX_TOKENS,
            system=SYSTEM_PROMPT,
            tools=tools.TOOLS,
            messages=history.as_list(),
        )

        # 応答の生content(テキスト+tool_useブロック)を会話履歴に保存
        history.add_assistant_content(response.content)

        if response.stop_reason != "tool_use":
            # 通常応答。テキスト部分だけを結合して返す
            return "".join(
                block.text for block in response.content if block.type == "text"
            )

        # tool_useブロックを見つけて、実際にツールを実行する
        for block in response.content:
            if block.type == "tool_use":
                print(f"[ツール実行] {block.name}({block.input})")
                result_text = tools.execute_tool(block.name, block.input)
                history.add_tool_result(block.id, result_text)
        # ツール実行結果を踏まえて、もう一度Claudeに問い合わせる(ループ継続)


# --- メインループ ---------------------------------------------------------

def main():
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        print("エラー: 環境変数 ANTHROPIC_API_KEY が設定されていません。")
        print("例: export ANTHROPIC_API_KEY='sk-ant-...'")
        sys.exit(1)

    client = Anthropic(api_key=api_key)
    history = ConversationHistory()

    # 環境変数 JARVIS_VOICE_INPUT=1 で音声入力モードに切り替え
    voice_mode = os.environ.get("JARVIS_VOICE_INPUT") == "1"

    print("JARVIS起動しました。終了するには 'exit' または 'quit' と入力してください。")
    if voice_mode:
        print("(音声入力モードです。マイクから話しかけてください)")
    if not voicevox.is_voicevox_running():
        print("(注意: VOICEVOXアプリが起動していないようです。音声再生は無効になります)")
    print()

    while True:
        try:
            if voice_mode:
                user_input = speech_input.listen()
                if user_input == speech_input.QUIT_SIGNAL:
                    print("JARVIS: 失礼いたします。")
                    break
                user_input = user_input.strip()
                if user_input:
                    print(f"あなた: {user_input}")
                else:
                    print("(音声が検出されなかったため、もう一度お試しください)")
            else:
                user_input = input("あなた: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nJARVIS: 失礼いたします。")
            break

        if not user_input:
            continue
        if user_input.lower() in ("exit", "quit", "終了"):
            print("JARVIS: 失礼いたします。")
            break

        history.add_user_message(user_input)

        try:
            reply = call_claude(client, history)
        except Exception as e:
            print(f"JARVIS: 申し訳ございません、エラーが発生いたしました。({e})")
            continue

        print(f"JARVIS: {reply}\n")
        voicevox.speak(reply)


if __name__ == "__main__":
    main()

